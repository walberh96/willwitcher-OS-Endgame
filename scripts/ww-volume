#!/usr/bin/env bash

# Dispositivo por defecto de salida
SINK='@DEFAULT_AUDIO_SINK@'
STEP='5%'   # 5% por “click” / scroll

case "$1" in
  up)
    wpctl set-volume "$SINK" "$STEP+"
    ;;
  down)
    wpctl set-volume "$SINK" "$STEP-"
    ;;
  mute|toggle-mute)
    wpctl set-mute "$SINK" toggle
    ;;
  *)
    echo "Uso: $0 {up|down|mute}" >&2
    exit 1
    ;;
esac

# Ejemplo de salida de este comando:
#   Volume: 0.61
#   Volume: 0.61 [MUTED]
INFO="$(wpctl get-volume "$SINK")"

# Segundo campo = 0.xx
VOL="$(printf '%s\n' "$INFO" | awk '{print $2}')"

# Porcentaje = 0.xx * 100
PCT="$(awk -v v="$VOL" 'BEGIN { printf("%d", v * 100) }')"

# ¿Está muteado?
if printf '%s\n' "$INFO" | grep -q '\[MUTED\]'; then
  ICON=""
  TEXT="Muted"
  PCT=0
else
  if [ "$PCT" -lt 50 ]; then
    ICON=""
  else
    ICON=""
  fi
  TEXT="${PCT}%"
fi

# Notificación (máx. ~3s)
notify-send -t 3000 "Volume $ICON" "$TEXT" \
  -h int:value:"$PCT" \
  -h string:x-canonical-private-synchronous:volume \
  -i audio-volume-high

