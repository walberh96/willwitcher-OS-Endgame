#!/usr/bin/env bash
set -euo pipefail

STATE_FILE="${HOME}/.ww-state.json"
DEFAULT_THEME="Catppuccin-BL-LB-Dark"

if ! command -v rofi >/dev/null 2>&1; then
  echo "Error: rofi is required but not installed." >&2
  exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "Error: jq is required but not installed." >&2
  exit 1
fi

themes="$(
  {
    find "${HOME}/.themes" -maxdepth 1 -mindepth 1 -type d 2>/dev/null || true
    find /usr/share/themes -maxdepth 1 -mindepth 1 -type d 2>/dev/null || true
  } | while IFS= read -r dir; do
    if [ -d "$dir/gtk-3.0" ] || [ -d "$dir/gtk-4.0" ]; then
      basename "$dir"
    fi
  done | sort -u
)"

[ -n "$themes" ] || {
  echo "No GTK themes found in ~/.themes or /usr/share/themes" >&2
  exit 0
}

choice="$(
  printf '%s\n' "$themes" | rofi -dmenu -i -p "GTK theme"
)" || exit 0

[ -n "$choice" ] || exit 0

new_theme="$choice"

if [ ! -f "$STATE_FILE" ]; then
  cat > "$STATE_FILE" <<EOF
{
  "if_initialized": true,
  "current_wallpaper": "",
  "current_gtk_theme": "",
  "current_cursor": ""
}
EOF
fi

tmp="$(mktemp)"

jq \
  --arg theme "$new_theme" \
  '
    .if_initialized = true
    | .current_gtk_theme = $theme
    | if has("current_wallpaper") then . else . + { "current_wallpaper": "" } end
    | if has("current_cursor") then . else . + { "current_cursor": "" } end
  ' \
  "$STATE_FILE" > "$tmp"

mv "$tmp" "$STATE_FILE"

ww-apply-gtk-theme || true

