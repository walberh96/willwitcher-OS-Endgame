#!/usr/bin/env bash
# WillwitcherOS: Waybar status JSON for the screen recorder (fancy)
# Tip: export WBAR_REC_COLOR, WBAR_SEL_COLOR, WBAR_IDLE_COLOR to override colors (hex)
set -euo pipefail

REC_COLOR="${WBAR_REC_COLOR:-#ff5f5f}"   # recording icon color
SEL_COLOR="${WBAR_SEL_COLOR:-#f2c94c}"   # selecting color (amber)
IDLE_COLOR="${WBAR_IDLE_COLOR:-}"        # optional idle color

json() { printf '%s\n' "$1"; }

recording_json() {
  local pid="$1"
  # etimes = elapsed seconds since start
  local et
  et="$(ps -o etimes= -p "$pid" 2>/dev/null | tr -d ' ' || echo 0)"
  [[ -z "$et" ]] && et=0
  local mm=$(( et / 60 ))
  local ss=$(( et % 60 ))
  # Red stop icon + elapsed time
  json "$(printf '{"text":"<span foreground=\\"%s\\">⏹</span> %d:%02d","class":"recording","alt":"rec","tooltip":"WillwitcherOS: Recording — middle click to stop","markup":"pango"}' "$REC_COLOR" "$mm" "$ss")"
}

selecting_json() {
  # Square icon to hint selection box
  json "$(printf '{"text":"<span foreground=\\"%s\\">▣</span> Select","class":"selecting","alt":"sel","tooltip":"WillwitcherOS: Select a region (ESC to cancel)","markup":"pango"}' "$SEL_COLOR")"
}

idle_json() {
  if [[ -n "$IDLE_COLOR" ]]; then
    json "$(printf '{"text":"<span foreground=\\"%s\\">●</span> rec","class":"idle","alt":"idle","tooltip":"WillwitcherOS: Idle — Left: Region • Right: Output • Middle: Toggle","markup":"pango"}' "$IDLE_COLOR")"
  else
    json '{"text":"● rec","class":"idle","alt":"idle","tooltip":"WillwitcherOS: Idle — Left: Region • Right: Output • Middle: Toggle"}'
  fi
}

if pid="$(pgrep -f -n "gpu-screen-recorder")"; then
  recording_json "$pid"
elif pgrep -x slurp >/dev/null; then
  selecting_json
else
  idle_json
fi
