#!/usr/bin/env bash
# WillwitcherOS: Waybar status JSON for the screen recorder (no timer, symbol-only idle)
set -euo pipefail

# Optional: set WBAR_PANGO=1 to enable inline colors (requires Waybar module with escape=false)
USE_PANGO="${WBAR_PANGO:-0}"
REC_COLOR="${WBAR_REC_COLOR:-#ff5f5f}"   # red for recording
SEL_COLOR="${WBAR_SEL_COLOR:-#f2c94c}"   # amber for selection

emit() { printf '%s\n' "$1"; }
span() {
  # $1=color, $2=text
  if [[ "$USE_PANGO" = "1" ]]; then
    printf '<span foreground="%s">%s</span>' "$1" "$2"
  else
    printf '%s' "$2"
  fi
}

recording_json() {
  # Red stop icon while recording
  local icon; icon="$(span "$REC_COLOR" "⏹")"
  if [[ "$USE_PANGO" = "1" ]]; then
    emit "{\"text\":\"$icon\",\"class\":\"recording\",\"alt\":\"rec\",\"tooltip\":\"WillwitcherOS: Recording — middle click to stop\",\"markup\":\"pango\"}"
  else
    emit "{\"text\":\"$icon\",\"class\":\"recording\",\"alt\":\"rec\",\"tooltip\":\"WillwitcherOS: Recording — middle click to stop\"}"
  fi
}

selecting_json() {
  # Square to hint selection box
  local icon; icon="$(span "$SEL_COLOR" "▣")"
  if [[ "$USE_PANGO" = "1" ]]; then
    emit "{\"text\":\"$icon\",\"class\":\"selecting\",\"alt\":\"sel\",\"tooltip\":\"WillwitcherOS: Select a region (ESC to cancel)\",\"markup\":\"pango\"}"
  else
    emit "{\"text\":\"$icon\",\"class\":\"selecting\",\"alt\":\"sel\",\"tooltip\":\"WillwitcherOS: Select a region (ESC to cancel)\"}"
  fi
}

idle_json() {
  # Just the record symbol; no text
  local icon="⏺"
  emit "{\"text\":\"$icon\",\"class\":\"idle\",\"alt\":\"idle\",\"tooltip\":\"WillwitcherOS: Idle — Left: Region • Right: Output • Middle: Toggle\"}"
}

if pgrep -f -n "gpu-screen-recorder" >/dev/null; then
  recording_json
elif pgrep -x slurp >/dev/null; then
  selecting_json
else
  idle_json
fi
