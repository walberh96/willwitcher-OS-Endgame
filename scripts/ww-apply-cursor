#!/usr/bin/env bash
set -euo pipefail

STATE_FILE="${HOME}/.ww-state.json"
DEFAULT_CURSOR="catppuccin-mocha-dark-cursors"
CURSOR_SIZE="24"

if ! command -v jq >/dev/null 2>&1; then
  echo "Error: jq is required but not installed." >&2
  exit 1
fi

update_ini_key() {
  local file="$1"
  local key="$2"
  local value="$3"

  mkdir -p "$(dirname "$file")"

  if [ ! -f "$file" ]; then
    {
      echo "[Settings]"
      printf '%s=%s\n' "$key" "$value"
    } > "$file"
    return
  fi

  if grep -qE "^[[:space:]]*$key=" "$file"; then
    sed -i -E "s|^[[:space:]]*$key=.*|$key=$value|" "$file"
  else
    if ! grep -qE "^\[Settings\]" "$file"; then
      printf '\n[Settings]\n' >> "$file"
    fi
    printf '%s=%s\n' "$key" "$value" >> "$file"
  fi
}

# Initialize state file if needed
if [ ! -f "$STATE_FILE" ]; then
  cat > "$STATE_FILE" <<EOF
{
  "if_initialized": true,
  "current_wallpaper": "",
  "current_gtk_theme": "",
  "current_cursor": ""
}
EOF
fi

cursor="$(jq -r '.current_cursor // ""' "$STATE_FILE" 2>/dev/null || printf '')"
if [ -z "$cursor" ]; then
  cursor="$DEFAULT_CURSOR"

  tmp="$(mktemp)"
  jq --arg cursor "$cursor" '.current_cursor = $cursor' "$STATE_FILE" > "$tmp"
  mv "$tmp" "$STATE_FILE"
fi

if command -v hyprctl >/dev/null 2>&1; then
  hyprctl keyword env "XCURSOR_THEME,$cursor" >/dev/null 2>&1 || true
  hyprctl keyword env "HYPRCURSOR_THEME,$cursor" >/dev/null 2>&1 || true
  hyprctl keyword env "XCURSOR_SIZE,${CURSOR_SIZE}" >/dev/null 2>&1 || true
  hyprctl keyword env "HYPRCURSOR_SIZE,${CURSOR_SIZE}" >/dev/null 2>&1 || true
  hyprctl setcursor "$cursor" "$CURSOR_SIZE" >/dev/null 2>&1 || true
fi

update_ini_key "${HOME}/.config/gtk-3.0/settings.ini" "gtk-cursor-theme-name" "$cursor"
update_ini_key "${HOME}/.config/gtk-3.0/settings.ini" "gtk-cursor-theme-size" "$CURSOR_SIZE"

update_ini_key "${HOME}/.config/gtk-4.0/settings.ini" "gtk-cursor-theme-name" "$cursor"
update_ini_key "${HOME}/.config/gtk-4.0/settings.ini" "gtk-cursor-theme-size" "$CURSOR_SIZE"

echo "Cursor applied: $cursor"

