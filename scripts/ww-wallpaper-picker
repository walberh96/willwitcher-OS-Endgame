#!/usr/bin/env bash
set -euo pipefail

WALLPAPER_DIR="${HOME}/Wallpapers"
CURRENT_FILE="${HOME}/.wallpaper.current"

# 1) Go to the wallpapers directory
cd "$WALLPAPER_DIR" || exit 1

# 2) Build the list using fd (as you normally do)
entries="$(
  fd 2>/dev/null | sort | while IFS= read -r path; do
    [ -n "$path" ] || continue

    # Skip directories (fd also returns images/ and live/)
    if [ -d "$path" ]; then
      continue
    fi

    rel="$path"           # e.g. images/cat.png or live/ganyu.gif
    base="${rel##*/}"     # file name
    ext="${base##*.}"
    lower_ext="$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')"

    case "$lower_ext" in
      jpg|jpeg|png|webp|bmp)
        tag="[image]"
        ;;
      gif|mp4|webm|mkv|mov)
        tag="[live]"
        ;;
      *)
        # Ignore extensions we don't care about
        continue
        ;;
    esac

    # Format for rofi: "[image] cat.png :: images/cat.png"
    printf "%s %s :: %s\n" "$tag" "$base" "$rel"
  done
)"

# 3) If nothing valid was found, exit quietly
[ -n "$entries" ] || { echo "No valid wallpapers found in $WALLPAPER_DIR" >&2; exit 0; }

# 4) Show the list in rofi with a search bar
choice="$(
  printf '%s\n' "$entries" | rofi -dmenu -i -p "Wallpaper"
)" || exit 0   # ESC / cancel

[ -n "$choice" ] || exit 0

# 5) Extract the relative path after " :: "
rel_path="${choice##* :: }"
rel_path="$(printf '%s\n' "$rel_path" | sed -e 's/^\s*//' -e 's/\s*$//')"
[ -n "$rel_path" ] || exit 0

# Save relative path to ~/.wallpaper.current
printf '%s\n' "$rel_path" > "$CURRENT_FILE"

# Absolute path to the selected file
full_path="${WALLPAPER_DIR}/${rel_path}"

ext="${full_path##*.}"
lower_ext="$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')"

# 6) Apply wallpaper:
#    - For live (gif/mp4/webm/mkv/mov): use mpvpaper
#    - For images: kill mpvpaper so the video disappears, then use swww

if [ "$lower_ext" = "gif" ] || [ "$lower_ext" = "mp4" ] || [ "$lower_ext" = "webm" ] || [ "$lower_ext" = "mkv" ] || [ "$lower_ext" = "mov" ]; then
  # LIVE → kill any existing mpvpaper and start a new one
  pkill mpvpaper 2>/dev/null || true
  mpvpaper -o "no-audio --loop" '*' "$full_path" >/dev/null 2>&1 &
else
  # STATIC IMAGE → kill mpvpaper so it doesn't cover the image, then use swww
  pkill mpvpaper 2>/dev/null || true

  if ! pgrep -x swww-daemon >/dev/null 2>&1; then
    swww init 2>/dev/null || true
  fi

  swww img "$full_path" \
    --transition-type random \
    --transition-fps 60 \
    --transition-duration 1
fi

