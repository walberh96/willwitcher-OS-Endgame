#!/usr/bin/env bash
set -euo pipefail

WALLPAPER_DIR="${HOME}/Wallpapers"
STATE_FILE="${HOME}/.ww-state.json"

# 1) Go to the wallpapers directory
cd "$WALLPAPER_DIR" || exit 1

# 2) Build the list using fd
entries="$(
  fd 2>/dev/null | sort | while IFS= read -r path; do
    [ -n "$path" ] || continue

    if [ -d "$path" ]; then
      continue
    fi

    rel="$path"
    base="${rel##*/}"
    ext="${base##*.}"
    lower_ext="$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')"

    case "$lower_ext" in
      jpg|jpeg|png|webp|bmp)
        tag="[image]"
        ;;
      gif|mp4|webm|mkv|mov)
        tag="[live]"
        ;;
      *)
        continue
        ;;
    esac

    printf "%s %s :: %s\n" "$tag" "$base" "$rel"
  done
)"

[ -n "$entries" ] || { echo "No valid wallpapers found in $WALLPAPER_DIR" >&2; exit 0; }

choice="$(
  printf '%s\n' "$entries" | rofi -dmenu -i -p "Wallpaper"
)" || exit 0

[ -n "$choice" ] || exit 0

rel_path="${choice##* :: }"
rel_path="$(printf '%s\n' "$rel_path" | sed -e 's/^\s*//' -e 's/\s*$//')"
[ -n "$rel_path" ] || exit 0

full_path="${WALLPAPER_DIR}/${rel_path}"

ext="${full_path##*.}"
lower_ext="$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')"

# Update .ww-state.json
if command -v jq >/dev/null 2>&1; then
  if [ ! -f "$STATE_FILE" ]; then
    cat > "$STATE_FILE" <<EOF
{
  "if_initialized": true,
  "current_wallpaper": "",
  "current_gtk_theme": "",
  "current_cursor": ""
}
EOF
  fi

  tmp="$(mktemp)"

  jq \
    --arg wp "$rel_path" \
    '
      .if_initialized = true
      | .current_wallpaper = $wp
      | if has("current_gtk_theme") then . else . + { "current_gtk_theme": "" } end
      | if has("current_cursor") then . else . + { "current_cursor": "" } end
    ' \
    "$STATE_FILE" > "$tmp"

  mv "$tmp" "$STATE_FILE"
fi

# Apply wallpaper immediately
if [ "$lower_ext" = "gif" ] || [ "$lower_ext" = "mp4" ] || [ "$lower_ext" = "webm" ] || [ "$lower_ext" = "mkv" ] || [ "$lower_ext" = "mov" ]; then
  pkill mpvpaper 2>/dev/null || true
  mpvpaper -o "no-audio --loop" '*' "$full_path" >/dev/null 2>&1 &
else
  pkill mpvpaper 2>/dev/null || true

  swww kill 2>/dev/null || true
  swww-daemon >/dev/null 2>&1 &
  sleep 0.15

  swww img "$full_path" \
    --transition-type none \
    --transition-duration 0
fi

