#!/usr/bin/env bash
set -euo pipefail

WALLPAPER_DIR="${HOME}/wallpapers"
CURRENT_FILE="${HOME}/.wallpaper.current"

# Nada que hacer si no existe
[ -f "$CURRENT_FILE" ] || exit 0

# Leer ruta relativa (ej: images/foo.png o live/bar.gif)
rel_path="$(sed -e 's/^\s*//' -e 's/\s*$//' "$CURRENT_FILE")"
[ -n "$rel_path" ] || exit 0

# Resolver ruta completa (permitimos absoluta por si acaso)
if [[ "$rel_path" = /* ]]; then
  wall="$rel_path"
else
  wall="${WALLPAPER_DIR}/${rel_path}"
fi

[ -f "$wall" ] || exit 0

ext="${wall##*.}"
ext_lower="$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')"

if [ "$ext_lower" = "gif" ]; then
  # Live wallpaper (gif): sin transición
  swww img "$wall" \
    --transition-type none
else
  # Imagen estática
  swww img "$wall" \
    --transition-type random \
    --transition-fps 60 \
    --transition-duration 1
fi

