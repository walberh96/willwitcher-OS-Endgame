#!/usr/bin/env bash
set -euo pipefail

WALLPAPER_DIR="${HOME}/Wallpapers"
CURRENT_FILE="${HOME}/.wallpaper.current"

[ -f "$CURRENT_FILE" ] || exit 0

rel_path="$(sed -e 's/^\s*//' -e 's/\s*$//' "$CURRENT_FILE")"
[ -n "$rel_path" ] || exit 0

# Resolve absolute path
if [[ "$rel_path" = /* ]]; then
  full_path="$rel_path"
else
  full_path="${WALLPAPER_DIR}/${rel_path}"
fi

[ -f "$full_path" ] || exit 0

ext="${full_path##*.}"
lower_ext="$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')"

if [ "$lower_ext" = "gif" ] || [ "$lower_ext" = "mp4" ] || [ "$lower_ext" = "webm" ] || [ "$lower_ext" = "mkv" ] || [ "$lower_ext" = "mov" ]; then
  # LIVE at startup → ensure only one mpvpaper
  pkill mpvpaper 2>/dev/null || true
  mpvpaper -o "no-audio --loop" '*' "$full_path" >/dev/null 2>&1 &
else
  # STATIC IMAGE at startup → same "hard reset" as in the picker
  pkill mpvpaper 2>/dev/null || true

  swww kill 2>/dev/null || true
  swww-daemon >/dev/null 2>&1 &
  sleep 0.15

  swww img "$full_path" \
    --transition-type none \
    --transition-duration 0
fi

