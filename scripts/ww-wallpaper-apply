#!/usr/bin/env bash
set -euo pipefail

WALLPAPER_DIR="${HOME}/Wallpapers"
CURRENT_FILE="${HOME}/.wallpaper.current"

[ -f "$CURRENT_FILE" ] || exit 0

rel_path="$(sed -e 's/^\s*//' -e 's/\s*$//' "$CURRENT_FILE")"
[ -n "$rel_path" ] || exit 0

# Resolver ruta absoluta
if [[ "$rel_path" = /* ]]; then
  full_path="$rel_path"
else
  full_path="${WALLPAPER_DIR}/${rel_path}"
fi

[ -f "$full_path" ] || exit 0

# Matar mpvpaper viejo siempre
pkill -x mpvpaper 2>/dev/null || true

ext="${full_path##*.}"
lower_ext="$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')"

if [ "$lower_ext" = "gif" ] || [ "$lower_ext" = "mp4" ] || [ "$lower_ext" = "webm" ] || [ "$lower_ext" = "mkv" ] || [ "$lower_ext" = "mov" ]; then
  mpvpaper -o "no-audio --loop" '*' "$full_path" >/dev/null 2>&1 &
else
  if ! pgrep -x swww-daemon >/dev/null 2>&1; then
    swww init 2>/dev/null || true
  fi

  swww img "$full_path" \
    --transition-type random \
    --transition-fps 60 \
    --transition-duration 1
fi

