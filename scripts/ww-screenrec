#!/usr/bin/env bash

# =============================================================================
# WillwitcherOS Screen Recorder — Dependencies
# =============================================================================
# Required:
# - gpu-screen-recorder   # the recorder backend (command: gpu-screen-recorder)
# - slurp                 # region/output picker on Wayland (command: slurp)
# - hyprland              # for `hyprctl monitors -j` (Hyprland required)
# - jq                    # JSON parsing for monitor scale (command: jq)
# - ffmpeg (ffplay)       # webcam overlay window (command: ffplay)
# - v4l-utils             # probe webcam formats (command: v4l2-ctl)
# - libnotify             # desktop notifications (command: notify-send)
# - procps                # process utilities (commands: pgrep, pkill)
# - gawk                  # arithmetic/formatting (command: awk)
# - grep                  # pattern matching (command: grep)
# - bash                  # script interpreter (shebang: #!/bin/bash)
#
# Optional:
# - waybar                # receives SIGRTMIN+8 to refresh indicator
# - xdg-user-dirs         # provides ~/.config/user-dirs.dirs (sourced if exists)
#
# Notes:
# - Files save to: $HOME/Videos/Recordings/screenrecording-YYYY-MM-DD_HH-MM-SS.mp4
# - Webcam overlay reads /dev/video0 by default; change if your cam is different.
# - Hyprland is assumed. On other compositors, replace `hyprctl` + scale logic.
#
# =============================================================================
# Usage Examples (replace `./script.sh` with your script path/name)
# =============================================================================
# Record the focused output (monitor), no audio:
#   ./script.sh output
#
# Record the focused output with merged audio from speakers + mic:
#   ./script.sh output --with-audio
#
# Record a region (click & drag with slurp), no audio:
#   ./script.sh region
#
# Record a region explicitly *without* audio (even if you normally use audio):
#   ./script.sh region --no-audio
#
# Record a region with merged audio from speakers + mic:
#   ./script.sh region --with-audio
#
# Add a live webcam overlay window:
#   ./script.sh output --with-webcam
#   ./script.sh region --with-webcam
#
# Audio + webcam together:
#   ./script.sh output --with-audio --with-webcam
#   ./script.sh region --with-audio --with-webcam
#
# Stop recording (toggle behavior): run the script again while recording:
#   ./script.sh
#
# Cancel a region selection: press ESC while the slurp selector is active.
#
# Summary of audio flags:
#   --with-audio  → force enable audio capture
#   --no-audio    → force disable audio capture (useful for “silent region” keybinds)

[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
OUTPUT_DIR="$HOME/Videos/Recordings"

# Create output dir if missing (notify on create; hard fail if cannot create)
if [[ ! -d "$OUTPUT_DIR" ]]; then
  if mkdir -p -- "$OUTPUT_DIR"; then
    notify-send "WillwitcherOS Screen Recorder" "Created $OUTPUT_DIR" -t 2000
  else
    notify-send "WillwitcherOS Screen Recorder: error" "Cannot create $OUTPUT_DIR" -u critical -t 5000
    exit 1
  fi
fi

SCOPE=""
AUDIO="false"
WEBCAM="false"

# -------------------------------------------------------------------------
# Argument parsing
# -------------------------------------------------------------------------
for arg in "$@"; do
  case "$arg" in
    --with-audio)
      AUDIO="true"
      ;;
    --no-audio)
      # Explicitly force audio off (even if some wrapper or alias adds --with-audio)
      AUDIO="false"
      ;;
    --with-webcam)
      WEBCAM="true"
      ;;
    output|region)
      SCOPE="$arg"
      ;;
  esac
done

cleanup_webcam() {
  pkill -f "WillwitcherOS-WebcamOverlay" 2>/dev/null
}

start_webcam_overlay() {
  cleanup_webcam

  # Get monitor scale
  local scale
  scale=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true) | .scale')

  # Target width (base 360px, scaled to monitor)
  local target_width
  target_width=$(awk "BEGIN {printf \"%.0f\", 360 * $scale}")

  # Try preferred 16:9 resolutions in order, use first available
  local preferred_resolutions=("640x360" "1280x720" "1920x1080")
  local video_size_arg=""
  local available_formats
  available_formats=$(v4l2-ctl --list-formats-ext -d /dev/video0 2>/dev/null)

  for resolution in "${preferred_resolutions[@]}"; do
    if echo "$available_formats" | grep -q "$resolution"; then
      video_size_arg="-video_size $resolution"
      break
    fi
  done

  ffplay -f v4l2 $video_size_arg -framerate 30 /dev/video0 \
    -vf "scale=${target_width}:-1" \
    -window_title "WillwitcherOS-WebcamOverlay" \
    -noborder \
    -fflags nobuffer -flags low_delay \
    -probesize 32 -analyzeduration 0 \
    -loglevel quiet &
  sleep 1
}

start_screenrecording() {
  local filename="$OUTPUT_DIR/screenrecording-$(date +'%Y-%m-%d_%H-%M-%S').mp4"
  local audio_args=""

  # Merge audio tracks into one - separate tracks only play one at a time in most players
  if [[ "$AUDIO" == "true" ]]; then
    audio_args="-a default_output|default_input"
  fi

  gpu-screen-recorder -w "$@" -f 60 -c mp4 -o "$filename" $audio_args &
  toggle_screenrecording_indicator
}

stop_screenrecording() {
  pkill -SIGINT -f "gpu-screen-recorder"  # SIGINT required to save video properly

  # Wait a maximum of 5 seconds to finish before hard killing
  local count=0
  while pgrep -f "gpu-screen-recorder" >/dev/null && [ $count -lt 50 ]; do
    sleep 0.1
    count=$((count + 1))
  done

  if pgrep -f "gpu-screen-recorder" >/dev/null; then
    pkill -9 -f "gpu-screen-recorder"
    cleanup_webcam
    notify-send "WillwitcherOS Screen Recorder: error" "Recording process had to be force-killed. Video may be corrupted." -u critical -t 5000
  else
    cleanup_webcam
    notify-send "WillwitcherOS Screen Recorder" "Saved to $OUTPUT_DIR" -t 2000
  fi
  toggle_screenrecording_indicator
}

toggle_screenrecording_indicator() {
  pkill -RTMIN+8 waybar
}

screenrecording_active() {
  pgrep -f "gpu-screen-recorder" >/dev/null || pgrep -x slurp >/dev/null || pgrep -f "WillwitcherOS-WebcamOverlay" >/dev/null
}

# -------------------------------------------------------------------------
# Main logic
# -------------------------------------------------------------------------
if screenrecording_active; then
  # If user hits the key while slurp is active, cancel the selection
  if pgrep -x slurp >/dev/null; then
    pkill -x slurp 2>/dev/null
  # If only webcam is running (no recorder), stop webcam
  elif pgrep -f "WillwitcherOS-WebcamOverlay" >/dev/null && ! pgrep -f "gpu-screen-recorder" >/dev/null; then
    cleanup_webcam
  # Otherwise stop the recording
  else
    stop_screenrecording
  fi

elif [[ "$SCOPE" == "output" ]]; then
  [[ "$WEBCAM" == "true" ]] && start_webcam_overlay

  if ! output=$(slurp -o -f "%o"); then
    [[ "$WEBCAM" == "true" ]] && cleanup_webcam
    exit 1
  fi

  if [[ -z "$output" ]]; then
    notify-send "WillwitcherOS Screen Recorder: error" "Could not detect monitor" -u critical
    [[ "$WEBCAM" == "true" ]] && cleanup_webcam
    exit 1
  fi

  start_screenrecording "$output"

else
  # Default: region capture (with or without audio depending on flags)
  [[ "$WEBCAM" == "true" ]] && start_webcam_overlay

  scale=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true) | .scale')

  if ! region=$(slurp -f "%wx%h+%x+%y"); then
    [[ "$WEBCAM" == "true" ]] && cleanup_webcam
    exit 1
  fi

  if [[ "$region" =~ ^([0-9]+)x([0-9]+)\+([0-9]+)\+([0-9]+)$ ]]; then
    w=$(awk "BEGIN {printf \"%.0f\", ${BASH_REMATCH[1]} * $scale}")
    h=$(awk "BEGIN {printf \"%.0f\", ${BASH_REMATCH[2]} * $scale}")
    x=$(awk "BEGIN {printf \"%.0f\", ${BASH_REMATCH[3]} * $scale}")
    y=$(awk "BEGIN {printf \"%.0f\", ${BASH_REMATCH[4]} * $scale}")
    scaled_region="${w}x${h}+${x}+${y}"
  else
    scaled_region="$region"
  fi

  start_screenrecording region -region "$scaled_region"
fi

