#!/usr/bin/env bash
set -euo pipefail

STATE_FILE="${HOME}/.ww-state.json"
DEFAULT_CURSOR="catppuccin-mocha-dark-cursors"

if ! command -v rofi >/dev/null 2>&1; then
  echo "Error: rofi is required but not installed." >&2
  exit 1
fi

if ! command -v jq >/dev/null 2>&1; then
  echo "Error: jq is required but not installed." >&2
  exit 1
fi

# Build cursor theme list
themes="$(
  {
    find "${HOME}/.icons" -maxdepth 1 -mindepth 1 -type d 2>/dev/null || true
    find /usr/share/icons -maxdepth 1 -mindepth 1 -type d 2>/dev/null || true
  } | while IFS= read -r dir; do
    [ -d "$dir/cursors" ] || continue
    basename "$dir"
  done | sort -u
)"

[ -n "$themes" ] || {
  echo "No cursor themes found in ~/.icons or /usr/share/icons" >&2
  exit 0
}

choice="$(
  printf '%s\n' "$themes" | rofi -dmenu -i -p "Cursor theme"
)" || exit 0

[ -n "$choice" ] || exit 0

new_cursor="$choice"

# Initialize state file if missing
if [ ! -f "$STATE_FILE" ]; then
  cat > "$STATE_FILE" <<EOF
{
  "if_initialized": true,
  "current_wallpaper": "",
  "current_gtk_theme": "",
  "current_cursor": ""
}
EOF
fi

tmp="$(mktemp)"

jq \
  --arg cursor "$new_cursor" \
  '
    .if_initialized = true
    | .current_cursor = $cursor
    | if has("current_wallpaper") then . else . + { "current_wallpaper": "" } end
    | if has("current_gtk_theme") then . else . + { "current_gtk_theme": "" } end
  ' \
  "$STATE_FILE" > "$tmp"

mv "$tmp" "$STATE_FILE"

ww-apply-cursor || true

