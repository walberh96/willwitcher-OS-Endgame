#!/usr/bin/env bash
set -u

SETUP_SCRIPT="$HOME/.local/bin/setup-git-gh"

msg() {
  local text="git-bootstrap: $*"
  echo "$text"
 }

msg "Starting git-bootstrap-check..."

if ! command -v git >/dev/null 2>&1; then
  msg "git is not installed or not in PATH. Exiting."
  exit 0
fi

if [[ ! -x "$SETUP_SCRIPT" ]]; then
  msg "Setup script not found or not executable: $SETUP_SCRIPT"
  msg "Make sure it exists and run: chmod +x \"$SETUP_SCRIPT\""
  exit 1
fi

if git config --global user.name >/dev/null 2>&1 && \
   git config --global user.email >/dev/null 2>&1; then
  msg "Git is already configured for this user (user.name and user.email present). Nothing to do."
  exit 0
fi

if ! command -v gh >/dev/null 2>&1; then
  msg "gh (GitHub CLI) is not installed or not in PATH."
  msg "You can still run the setup script manually in a terminal:"
  msg "  \"$SETUP_SCRIPT\""
  exit 0
fi

if ! command -v wezterm >/dev/null 2>&1; then
  msg "wezterm not found in PATH. Cannot open terminal."
  msg "Run the setup manually:"
  msg "  \"$SETUP_SCRIPT\""
  exit 1
fi

msg "Git is not configured yet. Launching wezterm with setup-git-gh.sh..."
wezterm start -- "$SETUP_SCRIPT" &

