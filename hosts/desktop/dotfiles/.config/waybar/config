[
  {
   "clock": {
  "format": "{:%I:%M %p  %m/%d}",
  "tooltip": false
},
"group/sys_controls": {
  "orientation": "horizontal",
  "modules": [
    "custom/notification",
    "custom/ww_srec",
    "pulseaudio",
    "custom/wifi",
    "custom/bluetooth"
  ]
},
    "custom/notification": {
      "escape": true,
      "exec": "swaync-client -swb",
      "exec-if": "which swaync-client",
      "format": " {icon} ",
      "format-icons": {
        "dnd-inhibited-none": "",
        "dnd-inhibited-notification": "<span foreground=\"red\"><sup></sup></span>",
        "dnd-none": "",
        "dnd-notification": "<span foreground=\"red\"><sup></sup></span>",
        "inhibited-none": "",
        "inhibited-notification": "<span foreground=\"red\"><sup></sup></span>",
        "none": "",
        "notification": "<span foreground=\"red\"><sup></sup></span>"
      },
      "on-click": "swaync-client -t -sw",
      "on-click-right": "swaync-client -d -sw",
      "return-type": "json",
      "tooltip": false
    },
    "custom/bluetooth": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.local/bin/ww-bluetooth-status",
    "interval": 3,
    "on-click": "~/.local/bin/ww-bluetooth-toggle",   // Left click: toggle on/off
    "on-click-right": "blueman-manager"               // Right click: open Blueman
  },

  "custom/wifi": {
    "format": "{}",
    "return-type": "json",
    "exec": "~/.local/bin/ww-wifi-status",
    "interval": 3,
    "on-click": "~/.local/bin/ww-wifi-toggle",        // Left click: toggle on/off
    "on-click-right": "nm-connection-editor"          // Right click: open NM editor
  },
    "custom/power": {
      "format": " ⏻ ",
      "on-click": "wlogout",
      "return-type": "string",
      "tooltip": "Power menu"
    },
    "custom/ww_srec": {
  "return-type": "json",
  "exec": "ww-screenrec-status",
  "interval": 3,
  "exec-on-event": true,
  "signal": 8,
  "format": "{}", 

  // Left click: full screen (output) WITH audio
  "on-click": "bash -lc 'ww-rec-rofi-screen'",

  // Right click: region WITHOUT audio
  "on-click-right": "bash -lc 'ww-rec-rofi-region'",

// Middle click: always just open the GTK app
  "on-click-middle": "bash -lc 'gpu-screen-recorder-gtk >/dev/null 2>&1 &'",  
  "tooltip": true
},

    "height": 50,
    "hyprland/workspaces": {
      "active-only": false,
      "all-outputs": true,
      "format": "{}",
      "format-icons": {
        "active": "",
        "default": "",
        "urgent": ""
      },
      "on-click": "activate",
      "on-scroll-down": "hyprctl dispatch workspace r+1",
      "on-scroll-up": "hyprctl dispatch workspace r-1",
      "persistent-workspaces": {
        "*": 5
      }
    },
    "layer": "top",
    "margin-bottom": -5,
    "modules-center": [
      "clock"
    ],
    "modules-left": [
      "hyprland/workspaces"
    ],
    "modules-right": [
  "group/sys_controls",
  "tray",
  "custom/power"
],
    "position": "top",
    "pulseaudio": {
  "format": "{volume}% {icon}",
  "format-icons": {
    "default": [
      "",
      "",
      ""
    ]
  },
  "on-click": "~/.local/bin/ww-audio-toggle",
  "on-click-right": "pwvucontrol"
},

    "spacing": 5,
    "tray": {
      "icon-size": 20,
      "spacing": 13
    }
  }
]
